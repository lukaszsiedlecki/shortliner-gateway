SERVER_PORT=8084

# Keycloak realm as the BROWSER sees it: the `iss` claim in every token, plus the
# login (auth) and logout (end_session) redirects.
KEYCLOAK_ISSUER_URI=http://keycloak.local/realms/shortliner
# Same realm as THIS SERVICE reaches it (token, JWKS, userinfo). Leave empty when it's
# the same as KEYCLOAK_ISSUER_URI (local dev); in the cluster it's the internal Service.
KEYCLOAK_INTERNAL_URI=
KEYCLOAK_CLIENT_ID=shortliner-gateway
KEYCLOAK_CLIENT_SECRET=change-me

SHORTLINER_BACKEND_URL=http://localhost:8080
ANALYTICS_BACKEND_URL=http://localhost:8082
PAYMENT_BACKEND_URL=http://localhost:8083
FRONTEND_URL=http://localhost:3000
